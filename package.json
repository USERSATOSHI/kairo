{
  "name": "kairo",
  "version": "0.1.0",
  "description": "A programmable, deterministic execution engine for Agent Development Workflows",
  "keywords": [
    "agent",
    "automation",
    "cli",
    "workflow"
  ],
  "homepage": "https://github.com/usersatoshi/kairo#readme",
  "bugs": {
    "url": "https://github.com/usersatoshi/kairo/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usersatoshi/kairo.git"
  },
  "bin": {
    "kairo": "packages/cli/dist/main.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "docs",
    "packages/cli/assets",
    "packages/cli/dist",
    "packages/web/dist",
    "plan.md",
    "TODO.md"
  ],
  "type": "module",
  "scripts": {
    "build:cli": "bun build packages/cli/src/main.ts --target=bun --outfile packages/cli/dist/main.js",
    "create-package": "bun run scripts/create-package.ts",
    "kairo": "bun run packages/cli/src/main.ts",
    "format": "oxfmt --write \"**/*.{ts,json,jsonc}\"",
    "format:check": "oxfmt --check \"**/*.{ts,json,jsonc}\"",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "prepare": "bun run build:cli",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kairo/adw": "0.1.0",
    "@kairo/api": "0.1.0",
    "@kairo/api-contracts": "0.1.0",
    "@kairo/cli": "0.1.0",
    "@kairo/domain": "0.1.0",
    "@kairo/executors": "0.1.0",
    "@kairo/harnesses": "0.1.0",
    "@kairo/persistence-sqlite": "0.1.0",
    "@kairo/runtime": "0.1.0",
    "@kairo/sandbox-worktree": "0.1.0",
    "@kairo/ticket-provider-github": "0.1.0",
    "@kairo/ticket-provider-local": "0.1.0",
    "@kairo/tickets": "0.1.0",
    "@kairo/web": "0.1.0",
    "@types/bun": "latest",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
